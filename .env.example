# ============================================
# All-in-One Tools Administrasi UMKM
# ============================================

# ============================================
# BACKEND-WORKERS (Cloudflare Workers)
# ============================================
# Variabel ini disetel sebagai secret di Cloudflare Workers.
# Jalankan perintah berikut untuk menyimpan secret:
# npx wrangler secret put <NAMA_VARIABEL>

# URL project Supabase Anda.
# Ditemukan di: Supabase Dashboard > Project Settings > API > Project URL
# Contoh: https://xyzabcdef.supabase.co
SUPABASE_URL=

# Service Role Key Supabase — digunakan untuk bypass RLS di backend-workers.
# PERHATIAN: Kunci ini memiliki akses penuh ke database.
# Jangan pernah commit atau expose kunci ini.
# Jalankan: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Secret key untuk mengenkripsi dan memverifikasi JWT token.
# Gunakan string acak yang panjang dan kompleks (minimal 32 karakter).
# Hasilkan dengan: openssl rand -base64 32
# Jalankan: npx wrangler secret put JWT_SECRET
JWT_SECRET=

# Kunci API Fonnte untuk integrasi notifikasi WhatsApp.
# Ditemukan di: https://fonnte.com/dashboard
WA_API_KEY=

# ID namespace KV untuk rate limiting.
# Buat dengan: wrangler kv:namespace create RATE_LIMIT_KV
# Atau lihat di wrangler.toml > [[kv_namespaces]] > id
RATE_LIMIT_KV=

# Secret key Cloudflare Turnstile untuk validasi token CAPTCHA di server.
# Ditemukan di: https://dash.cloudflare.com/turnstile
# Jalankan: npx wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=

# ============================================
# FRONTEND (Vite/React)
# ============================================
# Variabel frontend harus prefixed dengan VITE_ agar dapat diakses di browser.

# URL API backend Workers Anda.
# Development: http://localhost:8787 (Wrangler local dev server)
# Production: https://api.namabisnis.workers.dev (sesuaikan dengan domain Anda)
PUBLIC_API_URL=http://localhost:8787

# Site Key Cloudflare Turnstile untuk menampilkan widget CAPTCHA di frontend.
# Ditemukan di: https://dash.cloudflare.com/turnstile
# Ini adalah PUBLIC key — aman untuk diexpose di client-side.
VITE_TURNSTILE_SITE_KEY=
