# ============================================
# All-in-One Tools Administrasi UMKM — Backend Workers
# ============================================

# URL dari project Supabase Anda (ditemukan di dashboard Supabase > Project Settings > API)
# Contoh: https://xyz.supabase.co
SUPABASE_URL=

# Service Role Key Supabase Anda (digunakan untuk bypass RLS di backend-workers)
# PERHATIAN: Jaga kerahasiaan kunci ini. Untuk produksi Cloudflare, gunakan `wrangler secret put`
SUPABASE_SERVICE_ROLE_KEY=

# Secret Key untuk mengenkripsi JWT Token. Bebas gunakan string acak yang panjang.
JWT_SECRET=

# Domain frontend produksi Anda (untuk mengamankan CORS). 
# Gunakan http://localhost:5173 untuk testing lokal.
ALLOWED_ORIGIN="http://localhost:5173"

# Kunci API Fonnte untuk integrasi WhatsApp Notifikasi (Fase I)
WA_API_KEY=

# Kunci API Resend untuk integrasi Email Notifikasi (Fase I)
EMAIL_API_KEY=

# Username dan Password untuk Basic Auth Endpoint /docs dan /openapi.json di Production
# Jika tidak diisi (dan environment BUKAN localhost), endpoint akan mengembalikan 401 Unauthorized.
DOCS_USERNAME=
DOCS_PASSWORD=

# ============================================
# Opsional — Self-Host Node (VPS/Proxmox)
# ============================================
# Port untuk server Node (default 8787). Dipakai oleh src/server.node.ts
PORT=8787

# API Key Google Gemini untuk modul AI (jika diaktifkan)
GEMINI_API_KEY=

# Turnstile secret (Cloudflare) — wajib di Workers, opsional di self-host
TURNSTILE_SECRET_KEY=
# PSP / QRIS webhook secret (validasi signature x-psp-signature / x-webhook-secret / x-callback-token)
# Jalankan: npx wrangler secret put PSP_WEBHOOK_SECRET  (Cloudflare)  atau set di process.env (Node)
PSP_WEBHOOK_SECRET=
# Alternatif: QRIS_PROVIDER_SECRET / MIDTRANS_SERVER_KEY didukung sebagai fallback
# QRIS_PROVIDER_SECRET=
# MIDTRANS_SERVER_KEY=
